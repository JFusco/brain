{
  "name": "personal-brain",
  "packageManager": "pnpm@10.33.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "dependencies": {
    "@verndale/ui-design-brain": "1.18.2",
    "cms-field-vocabulary": "1.3.0"
  },
  "scripts": {
    "start": "pnpm --dir web/brain install --frozen-lockfile --prefer-offline && pnpm run viewer:build && node scripts/brain.mjs visual serve",
    "brain": "node scripts/brain.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "architecture:check": "node scripts/quality/check-architecture.mjs",
    "test": "node --test --test-concurrency=4 \"tests/*.test.mjs\"",
    "test:tooling": "node --test --test-timeout=60000 \"tests/tooling/*.test.mjs\"",
    "lint:commit": "commitlint --config commitlint.config.cjs",
    "lint:pr": "node scripts/validate_pr_body.cjs",
    "brain:check": "node scripts/brain.mjs check && node scripts/brain.mjs official check",
    "wiki:check": "node scripts/wiki/check.cjs",
    "viewer:build": "pnpm --dir web/brain run build",
    "verify:push": "pnpm run lint && pnpm run format:check && pnpm run architecture:check && pnpm test",
    "verify:ci": "pnpm run verify:push && pnpm run test:tooling && pnpm run brain:check && pnpm run wiki:check && pnpm run viewer:build"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
}
