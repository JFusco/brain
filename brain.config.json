{
  "schemaVersion": 1,
  "lookup": {
    "cacheHours": 24,
    "maxCacheFiles": 1000,
    "maxCacheBytes": 8388608
  },
  "curation": {
    "reviewDays": 30
  },
  "maintenance": {
    "linkLimit": 24
  },
  "domains": [
    "frontend",
    "react",
    "nextjs",
    "vercel",
    "tailwind",
    "cms/optimizely-saas",
    "cms/contentstack",
    "cms/sitecore-ai",
    "cms/sitecore-xp",
    "cms/contentful",
    "_unsorted"
  ],
  "capture": {
    "candidateBytes": 16384
  },
  "keywords": {
    "nextjs": [
      "next.js",
      "nextjs",
      "app router",
      "server component",
      "next/navigation",
      "app-router",
      "caching"
    ],
    "react": [
      "react",
      "useeffect",
      "usestate",
      "jsx",
      "hooks"
    ],
    "tailwind": [
      "tailwind",
      "@theme"
    ],
    "vercel": [
      "vercel",
      "deployment protection",
      "fluid compute"
    ],
    "cms/optimizely-saas": [
      "optimizely",
      "episerver",
      "cms-sdk"
    ],
    "cms/contentstack": [
      "contentstack"
    ],
    "cms/sitecore-ai": [
      "sitecoreai",
      "sitecore ai",
      "content-sdk",
      "xm cloud"
    ],
    "cms/sitecore-xp": [
      "sitecore xp",
      "sitecore experience platform",
      "jss",
      "sitecore 10"
    ],
    "cms/contentful": [
      "contentful"
    ],
    "frontend": [
      "accessibility",
      "a11y",
      "css",
      "html",
      "frontend"
    ]
  },
  "network": {
    "dnsFallback": "https://1.1.1.1/dns-query",
    "maxDownloadBytes": 67108864,
    "maxExpandedBytes": 268435456
  },
  "toolchain": {
    "gh": "/opt/homebrew/bin/gh"
  },
  "authorities": [
    {
      "id": "cms-field-vocabulary",
      "domain": "cms",
      "path": "../cms-field-vocabulary"
    },
    {
      "id": "accessibility-standards",
      "domain": "frontend",
      "path": "../@verndale/accessibility-standards"
    },
    {
      "id": "ui-design-brain",
      "domain": "frontend",
      "path": "../@verndale/ui-design-brain"
    }
  ]
}
