#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
. "$root/.githooks/tool-path.sh"
node "$root/scripts/nightly-push.mjs"

# Tests create their own repositories; inherited Git variables would redirect them.
for git_environment_variable in $(git rev-parse --local-env-vars); do
  unset "$git_environment_variable"
done
unset git_environment_variable
# Checks the current checkout, which is the pushed head in the delivery flow.
cd "$root" && pnpm run --silent verify:push
