#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
node "$root/scripts/brain.mjs" check --staged

# Brain excludes raw agent session stores from wiki discovery.
mkdir -p "$root/.state/wiki-plan-scope"
export WIKI_HOME="$root/.state/wiki-plan-scope"

# wiki-skill:start
wiki_skill_previous_status=$?
if ! node scripts/wiki/pre-commit.cjs; then
  echo "warning: wiki lifecycle failed; continuing" >&2
fi
if [ "$wiki_skill_previous_status" -ne 0 ]; then
  exit "$wiki_skill_previous_status"
fi
unset wiki_skill_previous_status
# wiki-skill:end
